# Neon Postgres（kindle-highlights と同じ手順で取得）
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# レシートOCR用 Anthropic APIキー（console.anthropic.com で取得）
ANTHROPIC_API_KEY="sk-ant-..."

# レシート画像保存用 Vercel Blob（Vercelダッシュボード > Storage > Blob で作成）
# 未設定の場合は画像をデータベースに直接保存します（ローカル開発用）
BLOB_READ_WRITE_TOKEN=""

# Google スプレッドシート自動反映（サービスアカウント）
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxx@xxx.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 「2026年売上台帳」のスプレッドシートID
SPREADSHEET_ID="1KLZYM6U92Ebg_Tp-DndHTU-j21zhXf0JWmP4iteOogA"

# アプリの共通パスワードとCookie署名用シークレット
APP_PASSWORD="onigiri"
AUTH_SECRET="ランダムな長い文字列に変更してください"
