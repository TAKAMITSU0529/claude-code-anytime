{
  "desktop_path": "~/Desktop",
  "categories": {
    "画像": {
      "folder": "画像フォルダ",
      "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".svg", ".webp", ".heic", ".tiff", ".ico"]
    },
    "ドキュメント": {
      "folder": "ドキュメントフォルダ",
      "extensions": [".pdf", ".doc", ".docx", ".txt", ".rtf", ".odt", ".pages"]
    },
    "スプレッドシート": {
      "folder": "スプレッドシートフォルダ",
      "extensions": [".xls", ".xlsx", ".csv", ".numbers", ".ods"]
    },
    "プレゼン": {
      "folder": "プレゼンフォルダ",
      "extensions": [".ppt", ".pptx", ".key", ".odp"]
    },
    "動画": {
      "folder": "動画フォルダ",
      "extensions": [".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".m4v"]
    },
    "音楽": {
      "folder": "音楽フォルダ",
      "extensions": [".mp3", ".wav", ".aac", ".flac", ".m4a", ".ogg", ".wma"]
    },
    "圧縮ファイル": {
      "folder": "圧縮ファイルフォルダ",
      "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".dmg", ".pkg"]
    },
    "コード": {
      "folder": "コードフォルダ",
      "extensions": [".py", ".js", ".ts", ".html", ".css", ".json", ".xml", ".java", ".c", ".cpp", ".swift", ".rb", ".go", ".rs", ".php", ".sql", ".sh"]
    },
    "フォント": {
      "folder": "フォントフォルダ",
      "extensions": [".ttf", ".otf", ".woff", ".woff2", ".eot"]
    },
    "その他": {
      "folder": "その他フォルダ",
      "extensions": []
    }
  }
}
